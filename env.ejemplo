# ---------------------------------------------------------------------------
# Copiá este archivo a .env y completá los valores:
#     copy env.ejemplo .env      (Windows)
#     cp env.ejemplo .env        (Linux / macOS)
# ---------------------------------------------------------------------------

# Planilla de Google -------------------------------------------------------
# El ID es el tramo largo de la URL:
# https://docs.google.com/spreadsheets/d/<ESTO>/edit#gid=0
SHEET_ID=1pDqMmQXn5BgECrv8xF_jXD2uE_Iyz9xq38HmnOxnvBU
# gid de la pestaña (el #gid=... de la URL). La primera hoja suele ser 0.
SHEET_GID=0

# La planilla se lee por la primera vía disponible de esta lista:
#
#   1. PLANILLA_CSV_FILE  — un CSV exportado a mano. No toca Google.
#   2. service account    — dejar credenciales/google-service-account.json
#                           y compartirle la planilla a ese mail. Es la única
#                           que funciona con la planilla privada. Ver el LEEME
#                           de la carpeta credenciales/.
#   3. GOOGLE_API_KEY     — exige que la planilla esté compartida como
#                           "cualquiera con el enlace puede ver".
#   4. export CSV público — ídem, y Google lo corta con 401 apenas deja de serlo.
#
# Ruta (dentro del contenedor) a un CSV exportado desde la planilla
# (Archivo > Descargar > CSV). Sirve para trabajar sin conexión.
# PLANILLA_CSV_FILE=/app/data/planilla.csv

# GOOGLE_API_KEY=
# Nombre de la pestaña; solo se usa con API key o service account. Ej: Hoja 1
# SHEET_NOMBRE_HOJA=

# GitHub -------------------------------------------------------------------
# MUY recomendado. Sin token la API de GitHub permite 60 pedidos por hora y con
# ~20 grupos se agota en la primera carga; con token son 5000/hora.
# Se crea en https://github.com/settings/tokens -> "Fine-grained token",
# solo lectura de repos públicos ("Public Repositories (read-only)").
GITHUB_TOKEN=

# Boton "Actualizar Google Sheet" -------------------------------------------
# Empuja los graficos por grupo + el ranking a la hoja "Graficos por grupo",
# via una Aplicacion web publicada del Apps Script de la planilla:
#   1. En el editor de Apps Script (Extensiones > Apps Script): Implementar >
#      Nueva implementacion > tipo "Aplicacion web". Ejecutar como "Yo",
#      acceso "Cualquier usuario". Copia la URL que termina en /exec.
#   2. En el mismo editor, Configuracion del proyecto > Propiedades del script
#      > agregar WEBHOOK_SECRET con un valor random (el mismo de aca abajo).
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Ajustes ------------------------------------------------------------------
PUERTO_WEB=5190
# Minutos que se reutiliza lo ya consultado a GitHub antes de volver a pedirlo.
CACHE_TTL_MIN=360
# Tope de commits leídos por repo.
MAX_COMMITS=500
# Repos consultados en paralelo.
CONCURRENCIA=4
# Se marca "aporte bajo" por debajo de este múltiplo de la cuota pareja
# (cuota pareja = total de commits / cantidad de integrantes).
UMBRAL_BAJA=0.4
# Gini por encima del cual el reparto del grupo se considera desparejo (0..1).
UMBRAL_GINI=0.5
# % de commits en las últimas 24 h que dispara "todo a último momento".
UMBRAL_ULTIMO_MOMENTO=60
